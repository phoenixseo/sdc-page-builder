{
	"name": "phoenixseo/sdc-page-builder",
	"description": "Dev tooling for the SDC Page Builder plugin: WPCS, PHPUnit against the WordPress test suite, translation files.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"php": ">=7.4",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"roots/wordpress": "^7.1",
		"wp-phpunit/wp-phpunit": "^7.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"roots/wordpress-core-installer": true
		},
		"platform": {
			"php": "7.4.33"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "find . -path ./vendor -prune -o -path ./node_modules -prune -o -name '*.php' -print | xargs -n1 php -l",
		"phpcs": "phpcs"
	}
}
